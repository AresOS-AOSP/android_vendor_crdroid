From 6ecf786ff9d38a72bdc34183862b2fadc5d1f2c0 Mon Sep 17 00:00:00 2001
From: Tim Zimmermann <tim@linux4.de>
Date: Sat, 27 Jan 2024 18:36:55 +0100
Subject: [PATCH 2/2] adb: Allow running as root on user builds

Change-Id: I7e7981f74b7ce7d69c3d187304c70dfb26369805
---
 daemon/main.cpp            | 3 +--
 daemon/restart_service.cpp | 5 +----
 sockets.cpp                | 2 +-
 3 files changed, 3 insertions(+), 7 deletions(-)

diff --git a/daemon/main.cpp b/daemon/main.cpp
index 71f67ea..a72bcf8 100644
--- a/daemon/main.cpp
+++ b/daemon/main.cpp
@@ -75,7 +75,6 @@ static bool should_drop_privileges() {
     // ro.secure:
     //   Drop privileges by default. Set to 1 on userdebug and user builds.
     bool ro_secure = android::base::GetBoolProperty("ro.secure", true);
-    bool ro_debuggable = __android_log_is_debuggable();
 
     // Drop privileges if ro.secure is set...
     bool drop = ro_secure;
@@ -84,7 +83,7 @@ static bool should_drop_privileges() {
     std::string prop = android::base::GetProperty("service.adb.root", "");
     bool adb_root = (prop == "1");
     bool adb_unroot = (prop == "0");
-    if (ro_debuggable && adb_root) {
+    if (adb_root) {
         drop = false;
     }
     // ... and "adb unroot" lets you explicitly drop privileges.
diff --git a/daemon/restart_service.cpp b/daemon/restart_service.cpp
index c942c1f..0309cac 100644
--- a/daemon/restart_service.cpp
+++ b/daemon/restart_service.cpp
@@ -53,10 +53,7 @@ void restart_root_service(unique_fd fd) {
     bool enabled = false;
     if (auto status = service->getEnabled(&enabled); !status.isOk()) {
 #endif
-    if (!__android_log_is_debuggable()) {
-        WriteFdExactly(fd.get(), "adbd cannot run as root in production builds\n");
-        return;
-    }
+
 #if defined(__ANDROID__) && !defined(__ANDROID_RECOVERY__)
     }
     if (!enabled) {
diff --git a/sockets.cpp b/sockets.cpp
index acb3de1..5b07c66 100644
--- a/sockets.cpp
+++ b/sockets.cpp
@@ -473,7 +473,7 @@ asocket* create_local_service_socket(std::string_view name, atransport* transpor
     VLOG(SOCKETS) << "LS(" << s->id << "): bound to '" << name << "' via " << fd_value;
 
 #if !ADB_HOST
-    if ((name.starts_with("root:") && getuid() != 0 && __android_log_is_debuggable()) ||
+    if ((name.starts_with("root:") && getuid() != 0) ||
         (name.starts_with("unroot:") && getuid() == 0) || name.starts_with("usb:") ||
         name.starts_with("tcpip:")) {
         D("LS(%d): enabling exit_on_close", s->id);
-- 
2.51.0

